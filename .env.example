# ─────────────────────────────────────────────────────────────
#  Copie este arquivo para .env.local e preencha os valores.
#  O .env.local NÃO vai para o git.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas (ou local: mongodb://127.0.0.1:27017/burger)
# No Atlas: Database > Connect > Drivers > copie a string e troque <password>.
MONGODB_URI="mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/brabos?retryWrites=true&w=majority"

# Segredo para assinar o token de login (JWT).
# Gere um valor aleatório com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Endereço público da loja, sem barra no final. OBRIGATÓRIO em produção.
# É a base do link no e-mail de recuperação de senha. Não é derivado da
# requisição de propósito: um "Origin" forjado faria o link do e-mail
# apontar para o site de quem atacou, entregando o token da conta.
APP_URL="http://localhost:3000"

# ── Dados da loja (visíveis no app, por isso o prefixo NEXT_PUBLIC_) ──

# Seu WhatsApp com DDI + DDD, só números. Ex: 5511988887777
NEXT_PUBLIC_WHATSAPP_NUMBER="5517981196312"

NEXT_PUBLIC_SHOP_NAME="Brabos Burguer"

# Taxa de entrega fixa em reais. Use 0 para entrega grátis.
NEXT_PUBLIC_DELIVERY_FEE="8"

# Pedido mínimo em reais (0 desativa a regra).
NEXT_PUBLIC_MIN_ORDER="0"

# Chave PIX da loja (telefone, CPF/CNPJ, e-mail ou chave aleatória).
# Vai na mensagem do WhatsApp quando o cliente escolhe PIX, junto do pedido
# de comprovante. Deixe vazio para não enviar esse bloco.
NEXT_PUBLIC_PIX_KEY="17991238343"
